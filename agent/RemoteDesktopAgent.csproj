<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Kein Konsolenfenster.

         Als Windows-Dienst fiel das nie auf: Dienste haben keinen Desktop. Seit
         der Agent als geplante Aufgabe in der Sitzung des Benutzers läuft (siehe
         setup/AgentTask.cs), bekäme ein Konsolenprogramm sein eigenes schwarzes
         Fenster — und zwar bei jeder Anmeldung. Gestartet und beendet wird der
         Agent im Fenster oder im Infobereich, nirgends sonst. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>RemoteDesktopAgent</RootNamespace>
    <AssemblyName>RemoteDesktopAgent</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Für die Windows-Runtime-APIs (Medien-Sitzungen) nötig; erlaubt zugleich
         das Bauen auf dem Linux-Container. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Das Netzprofil (Heimnetz · Tailscale · eigenes VPN) liest der Agent aus
         derselben Datei wie die Oberfläche. Die Logik dafür liegt in einem
         Projekt ohne Windows-Bezug und ist dort geprüft — zwei Leser derselben
         Datei mit je eigener Auslegung wären eine Falle. -->
    <ProjectReference Include="..\setup\RemoteDesktopSetup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="SIPSorcery" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
