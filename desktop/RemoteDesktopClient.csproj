<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RemoteDesktopClient</RootNamespace>
    <AssemblyName>RemoteDesktopClient</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Erlaubt das Bauen auf dem Linux-Container, genau wie im Agent. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Das WebView2-Paket bringt neben der WinForms- auch eine WPF-Hülle mit,
         und die verlangt eine andere WindowsBase-Fassung. Benutzt wird hier nur
         die WinForms-Hülle; die Meldung betrifft eine Datei, die nie geladen
         wird. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Die Einrichtungslogik. Sie liegt in einem eigenen Projekt ohne WinForms,
         damit sie sich ohne Windows prüfen lässt — siehe setup.Tests/. -->
    <ProjectReference Include="..\setup\RemoteDesktopSetup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Die gebaute React-App wandert neben die .exe. Sie entsteht mit
       `cd app && npm run build` und ist deshalb kein Teil dieses Builds —
       fehlt sie, sagt das Fenster beim Start, was zu tun ist. -->
  <ItemGroup>
    <Content Include="..\app\dist\**\*" LinkBase="app" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
