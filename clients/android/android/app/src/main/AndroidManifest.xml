<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Hält die Sitzung offen, während die App im Hintergrund ist. Der Typ
             muss ab Android 14 hier stehen und mit dem übereinstimmen, den der
             Dienst beim Start meldet, sonst beendet das System ihn sofort.

             dataSync und nicht connectedDevice: Letzteres verlangt seit
             Android 14 zusätzlich eine Erlaubnis aus einer festen Liste
             (Bluetooth, NFC, CHANGE_NETWORK_STATE, USB …). Keine davon
             beschreibt, was hier passiert — eine davon nur zum Freischalten des
             Typs zu erklären wäre ein Feigenblatt. Übertragen wird
             fortlaufend Bild und Eingabe über das Netz, und genau dafür ist
             dataSync da. -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Die drei Flächen aus Phase 15. Sie laufen ohne die App: angetippt
             wird ein Knopf, und was danach passiert, macht der native Teil
             allein (siehe surfaces/). -->

        <!-- Nicht freigegeben: den Rundruf zum Auslösen schickt das Widget an
             sich selbst, und die Aktualisierung schickt das System. Wäre er
             freigegeben, könnte jede App auf dem Handy Aktionen auf dem PC
             starten. -->
        <receiver
            android:name=".surfaces.ActionWidget"
            android:label="@string/widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_actions_info" />
        </receiver>

        <!-- Die Kachel muss freigegeben sein — sie wird von den
             Schnelleinstellungen des Systems gebunden. Die Erlaubnis stellt
             sicher, dass das auch wirklich nur das System kann. -->
        <service
            android:name=".surfaces.WakeTile"
            android:exported="true"
            android:icon="@android:drawable/ic_lock_power_off"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Die Weiche hinter einem Kürzel. Ohne Oberfläche und ohne Eintrag in
             den zuletzt verwendeten Apps: sie ist eine Zehntelsekunde da. -->
        <activity
            android:name=".surfaces.ShortcutRelay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Der Vordergrunddienst und seine Benachrichtigung. FOREGROUND_SERVICE
         reicht seit Android 14 nicht mehr allein — der Typ braucht seine eigene
         Erlaubnis. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Selbst-Update über die GitHub-Releases. Android zeigt dabei immer einen
         Systemdialog; stiller geht es außerhalb von Google Play nicht. Die
         eigentliche Absicherung ist die Signaturprüfung des Systems: eine APK
         darf nur über eine installierte, wenn sie mit demselben Schlüssel
         unterschrieben ist. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- QR-Kopplung. Wird erst beim ersten Scan erfragt, nicht beim Start. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Ohne die App bleibt sie bedienbar: gekoppelt wird dann über den
         getippten Code. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
